{
  "manifest_version": 1,
  "engine": "calorimetry",
  "label": "Calorimetria e bilanci energetici",
  "entry_points": {"engine": "engine.js", "view": "view.js", "style": "style.css"},
  "supported_schema_versions": [1],
  "supported_models": ["sensible_heat_compare", "heating_power", "thermal_mixing", "ice_water_balance", "phase_change_balance"],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "engine", "model", "parameters", "interaction", "display", "didactics"],
    "properties": {
      "schema_version": {"type": "integer", "const": 1},
      "engine": {"type": "string", "const": "calorimetry"},
      "model": {"type": "string", "enum": ["sensible_heat_compare", "heating_power", "thermal_mixing", "ice_water_balance", "phase_change_balance"]},
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mass_kg": {"type": "number", "exclusiveMinimum": 0},
          "heat_final_J": {"type": "number", "exclusiveMinimum": 0},
          "specific_heat_1_J_kgK": {"type": "number", "exclusiveMinimum": 0},
          "specific_heat_2_J_kgK": {"type": "number", "exclusiveMinimum": 0},
          "received_power_W": {"type": "number", "exclusiveMinimum": 0},
          "efficiency": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "specific_heat_J_kgK": {"type": "number", "exclusiveMinimum": 0},
          "duration_s": {"type": "number", "exclusiveMinimum": 0},
          "temperature_initial_C": {"type": "number"},
          "mass_1_kg": {"type": "number", "exclusiveMinimum": 0},
          "mass_2_kg": {"type": "number", "exclusiveMinimum": 0},
          "temperature_1_initial_C": {"type": "number"},
          "temperature_2_initial_C": {"type": "number"},
          "water_mass_kg": {"type": "number", "exclusiveMinimum": 0},
          "ice_mass_kg": {"type": "number", "exclusiveMinimum": 0},
          "water_specific_heat_J_kgK": {"type": "number", "exclusiveMinimum": 0},
          "ice_specific_heat_J_kgK": {"type": "number", "exclusiveMinimum": 0},
          "latent_heat_fusion_J_kg": {"type": "number", "exclusiveMinimum": 0},
          "water_temperature_initial_C": {"type": "number"},
          "ice_temperature_initial_C": {"type": "number"},
          "hot_mass_kg": {"type": "number", "exclusiveMinimum": 0},
          "hot_latent_heat_J_kg": {"type": "number", "exclusiveMinimum": 0},
          "water_latent_vaporization_J_kg": {"type": "number", "exclusiveMinimum": 0},
          "water_boiling_temperature_C": {"type": "number"}
        }
      },
      "interaction": {
        "type": "object", "additionalProperties": false,
        "required": ["allow_play", "allow_pause", "allow_reset", "allow_scrub", "playback_duration_s"],
        "properties": {
          "allow_play": {"type": "boolean"}, "allow_pause": {"type": "boolean"},
          "allow_reset": {"type": "boolean"}, "allow_scrub": {"type": "boolean"},
          "playback_duration_s": {"type": "number", "exclusiveMinimum": 0}
        }
      },
      "display": {
        "type": "object", "additionalProperties": false,
        "required": ["show_equations", "show_values"],
        "properties": {"show_equations": {"type": "boolean"}, "show_values": {"type": "boolean"}}
      },
      "didactics": {
        "type": "object", "additionalProperties": false,
        "required": ["learning_action_it", "model_note_it", "slider_label_it", "figure_note_it", "left_label_it", "right_label_it", "equation_html"],
        "properties": {
          "learning_action_it": {"type": "string", "minLength": 1}, "model_note_it": {"type": "string", "minLength": 1},
          "slider_label_it": {"type": "string", "minLength": 1}, "figure_note_it": {"type": "string", "minLength": 1},
          "left_label_it": {"type": "string", "minLength": 1}, "right_label_it": {"type": "string", "minLength": 1},
          "equation_html": {"type": "string", "minLength": 1}
        }
      }
    },
    "oneOf": [
      {"properties": {"model": {"const": "sensible_heat_compare"}, "parameters": {"required": ["mass_kg", "heat_final_J", "specific_heat_1_J_kgK", "specific_heat_2_J_kgK"], "additionalProperties": false, "properties": {"mass_kg": {}, "heat_final_J": {}, "specific_heat_1_J_kgK": {}, "specific_heat_2_J_kgK": {}}}}},
      {"properties": {"model": {"const": "heating_power"}, "parameters": {"required": ["received_power_W", "efficiency", "mass_kg", "specific_heat_J_kgK", "duration_s", "temperature_initial_C"], "additionalProperties": false, "properties": {"received_power_W": {}, "efficiency": {}, "mass_kg": {}, "specific_heat_J_kgK": {}, "duration_s": {}, "temperature_initial_C": {}}}}},
      {"properties": {"model": {"const": "thermal_mixing"}, "parameters": {"required": ["mass_1_kg", "mass_2_kg", "specific_heat_J_kgK", "temperature_1_initial_C", "temperature_2_initial_C"], "additionalProperties": false, "properties": {"mass_1_kg": {}, "mass_2_kg": {}, "specific_heat_J_kgK": {}, "temperature_1_initial_C": {}, "temperature_2_initial_C": {}}}}},
      {"properties": {"model": {"const": "ice_water_balance"}, "parameters": {"required": ["water_mass_kg", "ice_mass_kg", "water_specific_heat_J_kgK", "ice_specific_heat_J_kgK", "latent_heat_fusion_J_kg", "water_temperature_initial_C", "ice_temperature_initial_C"], "additionalProperties": false, "properties": {"water_mass_kg": {}, "ice_mass_kg": {}, "water_specific_heat_J_kgK": {}, "ice_specific_heat_J_kgK": {}, "latent_heat_fusion_J_kg": {}, "water_temperature_initial_C": {}, "ice_temperature_initial_C": {}}}}},
      {"properties": {"model": {"const": "phase_change_balance"}, "parameters": {"required": ["hot_mass_kg", "hot_latent_heat_J_kg", "water_specific_heat_J_kgK", "water_latent_vaporization_J_kg", "water_temperature_initial_C", "water_boiling_temperature_C"], "additionalProperties": false, "properties": {"hot_mass_kg": {}, "hot_latent_heat_J_kg": {}, "water_specific_heat_J_kgK": {}, "water_latent_vaporization_J_kg": {}, "water_temperature_initial_C": {}, "water_boiling_temperature_C": {}}}}}
    ]
  }
}
