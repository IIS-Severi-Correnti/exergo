{
  "manifest_version": 1,
  "engine": "fluid_statics",
  "label": "Fluidostatica",
  "entry_points": {
    "engine": "engine.js",
    "view": "view.js",
    "style": "style.css"
  },
  "supported_schema_versions": [1],
  "supported_models": ["hydrostatic_column"],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "engine",
      "model",
      "parameters",
      "interaction",
      "display",
      "didactics"
    ],
    "properties": {
      "schema_version": {"type": "integer", "const": 1},
      "engine": {"type": "string", "const": "fluid_statics"},
      "model": {"type": "string", "enum": ["hydrostatic_column"]},
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fluid_density_initial_kg_m3",
          "gravity_m_s2",
          "depth_reference_m",
          "depth_moving_initial_m",
          "depth_moving_final_m"
        ],
        "properties": {
          "fluid_density_initial_kg_m3": {"type": "number", "exclusiveMinimum": 0},
          "gravity_m_s2": {"type": "number", "exclusiveMinimum": 0},
          "depth_reference_m": {"type": "number", "exclusiveMinimum": 0},
          "depth_moving_initial_m": {"type": "number", "exclusiveMinimum": 0},
          "depth_moving_final_m": {"type": "number", "exclusiveMinimum": 0},
          "vessel_radius_1_m": {"type": "number", "exclusiveMinimum": 0},
          "vessel_radius_2_m": {"type": "number", "exclusiveMinimum": 0}
        }
      },
      "interaction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allow_play",
          "allow_pause",
          "allow_reset",
          "allow_scrub",
          "allow_density_change",
          "playback_duration_s",
          "density_min_kg_m3",
          "density_max_kg_m3"
        ],
        "properties": {
          "allow_play": {"type": "boolean"},
          "allow_pause": {"type": "boolean"},
          "allow_reset": {"type": "boolean"},
          "allow_scrub": {"type": "boolean"},
          "allow_density_change": {"type": "boolean"},
          "playback_duration_s": {"type": "number", "exclusiveMinimum": 0},
          "density_min_kg_m3": {"type": "number", "exclusiveMinimum": 0},
          "density_max_kg_m3": {"type": "number", "exclusiveMinimum": 0},
          "target_pressure_ratio": {"type": "number", "exclusiveMinimum": 0}
        }
      },
      "display": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "show_equations",
          "show_pressure_ratio",
          "show_vessel_width_note"
        ],
        "properties": {
          "show_equations": {"type": "boolean"},
          "show_pressure_ratio": {"type": "boolean"},
          "show_vessel_width_note": {"type": "boolean"}
        }
      },
      "didactics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_note_it",
          "learning_action_it",
          "column_1_label_it",
          "column_2_label_it"
        ],
        "properties": {
          "model_note_it": {"type": "string", "minLength": 1},
          "learning_action_it": {"type": "string", "minLength": 1},
          "column_1_label_it": {"type": "string", "minLength": 1},
          "column_2_label_it": {"type": "string", "minLength": 1},
          "exploration_note_it": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "constraints": [
    {
      "left": "parameters.depth_moving_final_m",
      "operator": ">",
      "right": "parameters.depth_moving_initial_m",
      "message": "depth_moving_final_m deve essere maggiore di depth_moving_initial_m"
    },
    {
      "left": "interaction.density_max_kg_m3",
      "operator": ">",
      "right": "interaction.density_min_kg_m3",
      "message": "density_max_kg_m3 deve essere maggiore di density_min_kg_m3"
    }
  ]
}
